APP_NAME="Glof Finance"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# The group operates in Kenya, so scheduled work (the monthly interest run) and
# every "today" in the UI happen on Nairobi time rather than UTC.
# Careful: on an existing installation whose timestamps were written under UTC,
# changing this shifts how those stored times are read back. Set it before the
# first migration, or leave an existing install as it is.
APP_TIMEZONE=Africa/Nairobi
# Laravel Herd serves this project at <folder-name>.test. Keep this in step
# with the domain Herd shows for the site, so links generated outside a request
# (scheduled jobs, exports, password-reset emails) point at the right place.
APP_URL=http://glof-finance-app-laravel-filament.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# These defaults match the MySQL that ships with Herd Pro (Services > MySQL).
# Create the database first: `herd mysql -e "CREATE DATABASE glof_finance_app"`.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=glof_finance_app
DB_USERNAME=root
DB_PASSWORD=

# No Herd Pro? SQLite needs no server at all. Comment out the six lines above,
# uncomment the line below, and run `touch database/database.sqlite`.
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Only needed if the Herd domain differs from the folder name — `npm run dev`
# reuses Herd's TLS certificate for this host so a secured (https) site does not
# block the dev server's assets.
# VITE_DEV_HOST=glof-finance-app-laravel-filament.test
